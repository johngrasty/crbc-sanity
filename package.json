{
  "name": "crbc",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "check": "tsc --noEmit",
    "schema:check": "sanity schema validate",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "verify": "npm run check && npm run lint && npm test && npm run schema:check && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "^5.0.0",
    "@sanity/client": "^7.27.0",
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/vision": "^4.14.2",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.1.1",
    "sanity": "^4.14.2",
    "sanity-plugin-media": "^4.0.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@sanity/runtime-cli": "12.4.0",
    "@types/react": "^19.1.12",
    "eslint": "^9.35.0",
    "lexorank": "1.0.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "overrides": {
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    },
    "sanity": {
      "@sanity/uuid": "3.0.3"
    }
  }
}

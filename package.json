{
  "name": "crbc",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "check": "tsc --noEmit",
    "contract:sync": "node scripts/sync-media-contract.ts",
    "schema:check": "sanity schema validate",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate && node scripts/mirror-types.ts",
    "verify": "export DO_NOT_TRACK=1 NO_UPDATE_NOTIFIER=1 npm_config_update_notifier=false && npm run check && npm run lint && npm test && npm run schema:check && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --require ./tests/loader/offline.cjs --import ./tests/loader/register.mjs --test 'tests/*.test.mjs' 'tests/*.test.ts'"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/assist": "^5.0.0",
    "@sanity/client": "^7.27.0",
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^3.5.4",
    "@sanity/vision": "^4.14.2",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.1.1",
    "sanity": "^4.14.2",
    "sanity-plugin-media": "^4.0.0",
    "speakingurl": "^14.0.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@sanity/runtime-cli": "12.4.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.1.12",
    "@types/react-dom": "~19.2.7",
    "@types/speakingurl": "^13.0.6",
    "esbuild": "^0.27.0",
    "eslint": "^9.35.0",
    "groq-js": "^1.30.3",
    "jsdom": "^26.1.0",
    "lexorank": "1.0.5",
    "prettier": "^3.6.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "overrides": {
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    },
    "sanity": {
      "@sanity/uuid": "3.0.3"
    }
  }
}
